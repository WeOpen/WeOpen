# Shared
APP_ENV=local
APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

# Web
# Browser calls use the Web app's same-origin /api proxy by default.
# Set NEXT_PUBLIC_API_BASE_URL only when intentionally bypassing the proxy.
NEXT_PUBLIC_API_BASE_URL=
WEOPEN_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=WeOpen
NEXT_PUBLIC_SHOW_DEV_CREDENTIALS=false

# API
DATABASE_URL=
MIGRATIONS_DIR=services/api/migrations
SESSION_SECRET=change-me-in-production
SECRET_ENCRYPTION_KEY=change-me-32-byte-key-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Providers
CLOUDFLARE_API_TOKEN=
VERCEL_API_TOKEN=
